# Kopieren nach .env und anpassen. Die .env gehört nicht in ein Repository.

# Öffentliche Adresse ohne Schrägstrich am Ende. Daraus entstehen die .ics- und Handy-Links.
PUBLIC_URL=https://calendar.panumic.com

# Geheimnis für die Namens-Hashes, mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
# Nie ändern, sobald Leute beigetreten sind: sonst passt kein gespeicherter Name mehr.
SERVER_SECRET=

# Port im Container. Wird nicht nach aussen veröffentlicht.
APP_PORT=38417

# Name des Containers. Diesen Namen trägst du im Caddyfile ein.
CONTAINER_NAME=panum-calendar

# Docker-Netzwerk, in dem dein Caddy-Container hängt. Herausfinden mit:
#   docker inspect <dein-caddy-container> --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
CADDY_NETWORK=

# true: X-Forwarded-For von Caddy wird für die IP-Limits benutzt.
# Nur richtig, solange der Dienst ausschliesslich über Caddy erreichbar ist (Standard hier).
TRUST_PROXY=true

# Nur für docker-compose.hostport.yml: Port auf dem Host, gebunden an 127.0.0.1.
HOST_PORT=47613
